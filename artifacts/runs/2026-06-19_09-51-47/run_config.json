{
  "schema_version": "2.0",
  "business_objective": "Build cc propensity model",
  "target_col": "target",
  "date_col": "snapshot_date",
  "primary_metric": "PR_AUC",
  "windows": {
    "observation_window_months": 3,
    "performance_window_months": 1,
    "snapshots_for_training": [
      "2025-01",
      "2025-02",
      "2025-03",
      "2025-04",
      "2025-05"
    ],
    "oot_snapshots": [
      "2025-06"
    ]
  },
  "data_strategy": {
    "group_col": null,
    "imputation_numeric": "median",
    "imputation_categorical": "mode",
    "outlier_strategy": "winsorize_99",
    "scaling_required": false,
    "woe_transformation": false,
    "correlation_threshold": 0.85,
    "psi_threshold": 0.25,
    "imbalance_tier": "moderate"
  },
  "feature_selection": {
    "max_missing_pct": 0.7,
    "min_iv": 0.02,
    "corr_threshold": 0.9,
    "top_k_by_importance": 200,
    "importance_method": "null_importance",
    "sample_rows_for_selection": 50000
  },
  "search": {
    "algorithms": [
      "XGBoost",
      "LightGBM",
      "HistGradientBoosting"
    ],
    "n_trials": 20,
    "tuner": "optuna",
    "early_stop_no_improve": 8,
    "hpo_overrides": {
      "LightGBM": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "num_leaves": [
          15,
          255
        ],
        "n_estimators": [
          100,
          1000
        ],
        "reg_alpha": [
          0.0,
          1.0
        ],
        "reg_lambda": [
          0.0,
          1.0
        ]
      },
      "XGBoost": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "max_depth": [
          3,
          10
        ],
        "n_estimators": [
          100,
          1000
        ],
        "subsample": [
          0.6,
          1.0
        ],
        "colsample_bytree": [
          0.6,
          1.0
        ]
      },
      "HistGradientBoosting": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "max_iter": [
          100,
          1000
        ],
        "max_depth": [
          3,
          10
        ],
        "l2_regularization": [
          0.0,
          1.0
        ]
      }
    }
  },
  "random_seed": 42,
  "rationale": "LightGBM and XGBoost are highly effective for tabular data and handle imbalanced datasets well. HistGradientBoosting is a strong contender for its efficiency and performance. These algorithms are well-suited for propensity modeling and have demonstrated success in similar banking applications (as suggested by general ML best practices and the nature of the problem)."
}