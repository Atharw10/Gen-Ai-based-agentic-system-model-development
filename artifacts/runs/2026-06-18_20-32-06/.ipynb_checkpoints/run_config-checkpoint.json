{
  "schema_version": "2.0",
  "business_objective": "Build CC propensity model",
  "target_col": "target",
  "date_col": "snapshot_date",
  "primary_metric": "PR_AUC",
  "windows": {
    "observation_window_months": 3,
    "performance_window_months": 1,
    "snapshots_for_training": [
      "2025-01",
      "2025-02",
      "2025-03",
      "2025-04",
      "2025-05"
    ],
    "oot_snapshots": [
      "2025-06"
    ]
  },
  "data_strategy": {
    "group_col": null,
    "imputation_numeric": "median",
    "imputation_categorical": "mode",
    "outlier_strategy": "winsorize_99",
    "scaling_required": true,
    "woe_transformation": false,
    "correlation_threshold": 0.85,
    "psi_threshold": 0.25,
    "imbalance_tier": "moderate"
  },
  "feature_selection": {
    "max_missing_pct": 0.7,
    "min_iv": 0.02,
    "corr_threshold": 0.9,
    "top_k_by_importance": 200,
    "importance_method": "null_importance",
    "sample_rows_for_selection": 50000
  },
  "search": {
    "algorithms": [
      "XGBoost",
      "LightGBM"
    ],
    "n_trials": 20,
    "tuner": "optuna",
    "early_stop_no_improve": 8,
    "hpo_overrides": {
      "LightGBM": {
        "learning_rate": [
          0.01,
          0.05,
          0.1,
          0.2
        ],
        "num_leaves": [
          31,
          63,
          127,
          255
        ],
        "n_estimators": [
          100,
          200,
          500
        ]
      },
      "XGBoost": {
        "learning_rate": [
          0.01,
          0.05,
          0.1,
          0.2
        ],
        "max_depth": [
          3,
          5,
          7
        ],
        "n_estimators": [
          100,
          200,
          500
        ]
      }
    }
  },
  "random_seed": 42,
  "rationale": "LightGBM and XGBoost are chosen for their efficiency and performance on tabular data, especially with imbalanced datasets. Logistic Regression is included as a baseline and for its interpretability, which is crucial in banking. (Cited: https://www.artefact.com/blog/scoring-customer-propensity-using-machine-learning-models-on-google-analytics-data, https://www.oajaiml.com/uploads/archivepdf/237151184.pdf)"
}