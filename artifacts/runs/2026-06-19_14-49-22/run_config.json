{
  "schema_version": "2.0",
  "business_objective": "propensity model",
  "target_col": "target",
  "date_col": "snapshot_date",
  "primary_metric": "PR_AUC",
  "windows": {
    "observation_window_months": 5,
    "performance_window_months": 1,
    "snapshots_for_training": [
      "2025-01",
      "2025-02",
      "2025-03",
      "2025-04",
      "2025-05"
    ],
    "oot_snapshots": [
      "2025-06"
    ]
  },
  "data_strategy": {
    "group_col": null,
    "imputation_numeric": "median",
    "imputation_categorical": "mode",
    "outlier_strategy": "winsorize_99",
    "scaling_required": false,
    "woe_transformation": false,
    "correlation_threshold": 0.85,
    "psi_threshold": 0.25,
    "imbalance_tier": "moderate"
  },
  "feature_selection": {
    "max_missing_pct": 0.7,
    "min_iv": 0.02,
    "corr_threshold": 0.9,
    "top_k_by_importance": 200,
    "importance_method": "null_importance",
    "sample_rows_for_selection": 50000
  },
  "search": {
    "algorithms": [
      "LightGBM",
      "XGBoost",
      "HistGradientBoosting"
    ],
    "n_trials": 20,
    "tuner": "optuna",
    "early_stop_no_improve": 8,
    "hpo_overrides": {
      "LightGBM": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "num_leaves": [
          15,
          255
        ],
        "scale_pos_weight": [
          10,
          20
        ]
      },
      "XGBoost": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "max_depth": [
          3,
          10
        ],
        "scale_pos_weight": [
          10,
          20
        ]
      },
      "HistGradientBoosting": {
        "learning_rate": [
          0.01,
          0.2
        ],
        "max_leaf_nodes": [
          15,
          255
        ]
      }
    }
  },
  "random_seed": 42,
  "rationale": "LightGBM and XGBoost are highly effective for tabular data and handle imbalanced datasets well. HistGradientBoosting is a strong alternative, often providing good performance with less tuning. These algorithms are well-suited for propensity modeling as described in various sources (e.g., Altexsoft, Comarch). LogisticRegression is a baseline but may struggle with complex interactions in imbalanced data. RandomForest and GradientBoosting are also viable but LightGBM and XGBoost often offer better performance and speed."
}